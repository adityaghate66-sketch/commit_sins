# COMMIT SINS — local environment template
#
# Copy this file to `.env` and adjust the values for your machine.
# `.env` is ignored by Git. Never commit real credentials.

# Port for the standalone Express scan API (backend/src/server.js).
PORT=5001

# Origin allowed to call the scan API (the Vite dashboard).
CLIENT_URL=http://localhost:5173

# The Vite dev server proxies /api/scan and /api/health to PORT above, so the
# dashboard needs no extra configuration. Production runs `pnpm build` and
# `pnpm start`, which serves the built dashboard and API from dist/server.js.
